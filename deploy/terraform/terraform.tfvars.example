# Copy to terraform.tfvars and replace every placeholder. terraform.tfvars is
# ignored because adopter-specific IDs are configuration, not public fixtures.
project_id                 = "example-folio-aware-project"
github_repository_id       = "123456789"
github_repository_owner_id = "987654321"
generation_model           = "gemini-2.5-flash"
allowed_origins             = ["https://portfolio.example"]

# Per-process application admission controls. Pair these with deployment-level
# edge rate limits, billing budgets, and alerts before accepting public traffic.
rate_limit_per_client_requests = 10
rate_limit_global_requests     = 100
rate_limit_window_seconds      = 60
rate_limit_max_clients         = 10000
answer_concurrency_limit       = 4

# Pin the reusable workflow to the exact FolioAware commit used by the caller.
deploy_workflow_ref = "example-org/folio-aware/.github/workflows/deploy-reusable.yml@0123456789abcdef0123456789abcdef01234567"

# Pin the reusable sync workflow to the same reviewed FolioAware commit.
sync_workflow_ref = "example-org/folio-aware/.github/workflows/sync-reusable.yml@0123456789abcdef0123456789abcdef01234567"

# Safe bootstrap default: foundation only. Do not enable until an image digest
# and both Secret Manager versions exist.
deploy_service = false

# Keep unauthenticated access disabled for the first authenticated smoke test.
# Enabling this alone is not sufficient for production: first provision and
# verify the approved edge controls that prevent direct Cloud Run URL bypass.
allow_unauthenticated_invocation = false

# Public edge phase: the load balancer and Cloud Armor must exist before the
# Cloud Run service accepts unauthenticated traffic. Add the returned
# public_edge_ip as an A record for api_domain, then wait for the managed TLS
# certificate to become ACTIVE.
enable_public_edge = false
api_domain        = null

# Cloud Armor applies this threshold independently to each source IP.
edge_rate_limit_per_ip_requests = 30
edge_rate_limit_window_seconds  = 60

# Phase two example:
# deploy_service = true
# container_image = "us-central1-docker.pkg.dev/example-folio-aware-project/folio-aware/api@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
