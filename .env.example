# Runtime environment: development, test, or production.
FOLIOAWARE_ENVIRONMENT=development

# Dependency composition: local (offline deterministic adapters) or google.
FOLIOAWARE_BACKEND=local

# JSON array of exact browser origins allowed to read cross-origin API responses.
# Keep empty for no cross-origin browser access. Production origins use HTTPS.
FOLIOAWARE_ALLOWED_ORIGINS=[]

# HMAC secret used to pseudonymize optional browser session identifiers.
# Generate a strong secret for deployed environments; never commit its value.
FOLIOAWARE_SESSION_HASH_SECRET=

# Root path containing the explicitly approved portfolio manifest and sources.
FOLIOAWARE_CONTENT_ROOT=examples/synthetic-portfolio

# Retrieval distance threshold selected from versioned evaluations.
FOLIOAWARE_RETRIEVAL_DISTANCE_THRESHOLD=0.72

# Maximum number of evidence chunks considered for one answer.
FOLIOAWARE_RETRIEVAL_TOP_K=5

# In-process public-answer admission limits. These complement deployment-level
# edge controls and are enforced independently by each running process.
FOLIOAWARE_RATE_LIMIT_PER_CLIENT_REQUESTS=10
FOLIOAWARE_RATE_LIMIT_GLOBAL_REQUESTS=100
FOLIOAWARE_RATE_LIMIT_WINDOW_SECONDS=60
FOLIOAWARE_RATE_LIMIT_MAX_CLIENTS=10000
FOLIOAWARE_ANSWER_CONCURRENCY_LIMIT=4

# Number of days anonymized question records are retained.
FOLIOAWARE_TELEMETRY_RETENTION_DAYS=90

# Owner-maintained aliases used for deterministic telemetry classification.
FOLIOAWARE_INSIGHT_RULES_PATH=examples/synthetic-portfolio/insight-topics.yaml

# A topic must occur this many times in a reporting period to be repeated.
FOLIOAWARE_INSIGHT_MIN_QUESTION_COUNT=2

# Bearer token protecting the owner-only insight report endpoint.
# Generate a strong secret for deployed environments; never commit its value.
FOLIOAWARE_OWNER_REPORT_TOKEN=

# Google project/embedding settings are required by Google-backed sync and API.
# Generation settings are used only by the serving API.
FOLIOAWARE_GOOGLE_CLOUD_PROJECT=
FOLIOAWARE_GOOGLE_CLOUD_LOCATION=global
FOLIOAWARE_FIRESTORE_DATABASE=(default)
FOLIOAWARE_EMBEDDING_MODEL=gemini-embedding-001
FOLIOAWARE_EMBEDDING_DIMENSIONS=768
FOLIOAWARE_GENERATION_MODEL=
FOLIOAWARE_GOOGLE_REQUEST_TIMEOUT_SECONDS=15
FOLIOAWARE_GENERATION_MAX_OUTPUT_TOKENS=512
